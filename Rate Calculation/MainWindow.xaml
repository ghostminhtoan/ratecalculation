<Window x:Class="Rate_Calculation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Rate_Calculation"
        mc:Ignorable="d"
        Title="🎲 Harvard Sic Bo Laboratory" Height="700" Width="840"
        Background="#1C1C1C" Foreground="#FFFFFF" FontFamily="Segoe UI"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBg" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="CardBg" Color="#323232"/>
        <SolidColorBrush x:Key="BorderColor" Color="#444444"/>
        <SolidColorBrush x:Key="AccentColor" Color="#60CDFF"/>
        <SolidColorBrush x:Key="AccentHoverColor" Color="#0078D4"/>
        <SolidColorBrush x:Key="MutedText" Color="#AAAAAA"/>
        <SolidColorBrush x:Key="WinColor" Color="#22C55E"/>
        <SolidColorBrush x:Key="DrawColor" Color="#EAB308"/>
        <SolidColorBrush x:Key="LoseColor" Color="#EF4444"/>
        <SolidColorBrush x:Key="RedBall" Color="#EF4444"/>
        <SolidColorBrush x:Key="WhiteBall" Color="#F8FAFC"/>

        <!-- Panel border style -->
        <Style x:Key="PanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="6"/>
        </Style>

        <!-- Generic button style -->
        <Style x:Key="W11ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3D3D3D"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="W11PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource W11ButtonStyle}">
            <Setter Property="Background" Value="{StaticResource AccentHoverColor}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1084E3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Big global resolve buttons -->
        <Style x:Key="GlobalWinButtonStyle" TargetType="Button" BasedOn="{StaticResource W11ButtonStyle}">
            <Setter Property="Background" Value="#1B4D2B"/>
            <Setter Property="BorderBrush" Value="#22C55E"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#206435"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlobalDrawButtonStyle" TargetType="Button" BasedOn="{StaticResource W11ButtonStyle}">
            <Setter Property="Background" Value="#4A3B0F"/>
            <Setter Property="BorderBrush" Value="#EAB308"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5C4A14"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GlobalLoseButtonStyle" TargetType="Button" BasedOn="{StaticResource W11ButtonStyle}">
            <Setter Property="Background" Value="#5B1D1D"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#722323"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Chip RadioButton style -->
        <Style x:Key="ChipButtonStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Chips"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="#252525" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="16" Padding="8,4" Margin="1">
                            <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" FontSize="11"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource AccentHoverColor}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#3D3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Betting cell style -->
        <Style x:Key="BetCellBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Mini W/D/L cell action ToggleButtons -->
        <Style x:Key="MiniToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Margin" Value="0.5"/>
            <Setter Property="FontSize" Value="7"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#88FFFFFF"/>
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="1.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniWinToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MiniToggleStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#22C55E"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#16A34A"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniDrawToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MiniToggleStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#EAB308"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#CA8A04"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniLoseToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource MiniToggleStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="#EF4444"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsChecked" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#DC2626"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="6,0,6,10">
            <StackPanel>
                <TextBlock Text="🎲 Harvard Sic Bo Laboratory" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Win / Loss Combination Simulator for Study Purpose" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Background="#2B2B2B" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4"
                    Padding="8,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="WPF Responsive Layout" Foreground="{StaticResource AccentColor}" FontSize="10"/>
            </Border>
        </Grid>

        <!-- Main content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <!-- Left Column: contains Panel 1 and Panel 2 stacked vertically -->
                <StackPanel Orientation="Vertical" Width="402">
                    
                    <!-- Panel 1: Balance (390x290) -->
                    <Border Style="{StaticResource PanelBorderStyle}" Width="390" Height="290">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="💼 Panel 1: Số tiền ban đầu" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Content="Reset Session" HorizontalAlignment="Right" Style="{StaticResource W11ButtonStyle}" Padding="8,3" Click="ResetSession_Click"/>
                            </DockPanel>

                            <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TxtBalance" Text="1,000" FontSize="36" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentColor}" FontFamily="Consolas"/>
                                    <TextBlock Text=" xu" FontSize="13" Foreground="{StaticResource MutedText}" VerticalAlignment="Bottom" Margin="4,0,0,8"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputInitBalance" Grid.Column="0" Background="#202020" Foreground="White"
                                         BorderBrush="{StaticResource BorderColor}" Padding="6" FontSize="13"
                                         VerticalContentAlignment="Center" Margin="0,0,6,0"
                                         GotFocus="InputInitBalance_GotFocus"/>
                                <Button Grid.Column="1" Content="Khởi tạo" Style="{StaticResource W11PrimaryButtonStyle}"
                                        Width="80" Click="SetInitialBalance_Click"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,3,0">
                                    <StackPanel>
                                        <TextBlock Text="Số dư ban đầu" FontSize="10" Foreground="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="LblInitBalance" Text="1,000" FontSize="16" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="3,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Lợi nhuận ròng" FontSize="10" Foreground="{StaticResource MutedText}"/>
                                        <TextBlock x:Name="LblNetProfit" Text="0" FontSize="16" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="{StaticResource AccentColor}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Panel 2: Betting Board (390x290) -->
                    <Border Style="{StaticResource PanelBorderStyle}" Width="390" Height="290">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="🎯 Panel 2: Đặt cược &amp; Kết quả nhanh" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4"/>

                            <!-- Betting Grid: 4 columns x 3 rows cells -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Col 0: 4 Trắng, 3 Trắng 1 Đỏ, 2 Đỏ 2 Trắng -->
                                <UniformGrid Grid.Column="0" Columns="1">
                                    <!-- 4 Trắng cell -->
                                    <Border x:Name="Cell_4trang" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="4trang">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                </StackPanel>
                                                <TextBlock Text="1:14" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_4trang" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_4trang_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="4trang|win"/>
                                                    <ToggleButton x:Name="Btn_4trang_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="4trang|draw"/>
                                                    <ToggleButton x:Name="Btn_4trang_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="4trang|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 3 Trắng 1 Đỏ cell -->
                                    <Border x:Name="Cell_3t1d" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="3t1d">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                </StackPanel>
                                                <TextBlock Text="1:2.8" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_3t1d" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_3t1d_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="3t1d|win"/>
                                                    <ToggleButton x:Name="Btn_3t1d_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="3t1d|draw"/>
                                                    <ToggleButton x:Name="Btn_3t1d_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="3t1d|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 2 Đỏ 2 Trắng cell -->
                                    <Border x:Name="Cell_2d2t" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="2d2t">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                </StackPanel>
                                                <TextBlock Text="1:1.6" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_2d2t" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_2d2t_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="2d2t|win"/>
                                                    <ToggleButton x:Name="Btn_2d2t_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="2d2t|draw"/>
                                                    <ToggleButton x:Name="Btn_2d2t_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="2d2t|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>

                                <!-- Col 1: Chẵn, Xỉu -->
                                <UniformGrid Grid.Column="1" Columns="1" Rows="3">
                                    <!-- Chẵn -->
                                    <Border x:Name="Cell_chan" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="chan">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="Chẵn" FontSize="15" FontWeight="Bold" Foreground="#3B82F6"/>
                                                <TextBlock Text="1:0.96" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_chan" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_chan_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="chan|win"/>
                                                    <ToggleButton x:Name="Btn_chan_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="chan|draw"/>
                                                    <ToggleButton x:Name="Btn_chan_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="chan|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Xỉu -->
                                    <Border x:Name="Cell_xiu" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="xiu">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="Xỉu" FontSize="15" FontWeight="Bold" Foreground="#3B82F6"/>
                                                <TextBlock Text="1:0.96" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_xiu" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_xiu_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="xiu|win"/>
                                                    <ToggleButton x:Name="Btn_xiu_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="xiu|draw"/>
                                                    <ToggleButton x:Name="Btn_xiu_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="xiu|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Empty -->
                                    <Border Margin="2" Background="Transparent"/>
                                </UniformGrid>

                                <!-- Col 2: Lẻ, Tài -->
                                <UniformGrid Grid.Column="2" Columns="1" Rows="3">
                                    <!-- Lẻ -->
                                    <Border x:Name="Cell_le" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="le">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="Lẻ" FontSize="15" FontWeight="Bold" Foreground="#FF6B35"/>
                                                <TextBlock Text="1:0.96" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_le" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_le_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="le|win"/>
                                                    <ToggleButton x:Name="Btn_le_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="le|draw"/>
                                                    <ToggleButton x:Name="Btn_le_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="le|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Tài -->
                                    <Border x:Name="Cell_tai" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="tai">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="4,2">
                                                <TextBlock Text="Tài" FontSize="15" FontWeight="Bold" Foreground="#FF6B35"/>
                                                <TextBlock Text="1:0.96" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_tai" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_tai_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="tai|win"/>
                                                    <ToggleButton x:Name="Btn_tai_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="tai|draw"/>
                                                    <ToggleButton x:Name="Btn_tai_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="tai|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Empty -->
                                    <Border Margin="2" Background="Transparent"/>
                                </UniformGrid>

                                <!-- Col 3: 4 Đỏ, 3 Đỏ 1 Trắng, Combo 4Đ/4T -->
                                <UniformGrid Grid.Column="3" Columns="1">
                                    <!-- 4 Đỏ -->
                                    <Border x:Name="Cell_4do" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="4do">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                </StackPanel>
                                                <TextBlock Text="1:14" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_4do" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_4do_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="4do|win"/>
                                                    <ToggleButton x:Name="Btn_4do_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="4do|draw"/>
                                                    <ToggleButton x:Name="Btn_4do_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="4do|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- 3 Đỏ 1 Trắng -->
                                    <Border x:Name="Cell_3d1t" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="3d1t">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource RedBall}" Margin="0.3"/>
                                                    <Ellipse Width="6" Height="6" Fill="{StaticResource WhiteBall}" Margin="0.3"/>
                                                </StackPanel>
                                                <TextBlock Text="1:2.8" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_3d1t" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_3d1t_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="3d1t|win"/>
                                                    <ToggleButton x:Name="Btn_3d1t_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="3d1t|draw"/>
                                                    <ToggleButton x:Name="Btn_3d1t_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="3d1t|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <!-- Combo 4Đ/4T -->
                                    <Border x:Name="Cell_4combo" Style="{StaticResource BetCellBorderStyle}"
                                            MouseLeftButtonDown="Cell_LeftClick" MouseRightButtonDown="Cell_RightClick" MouseDown="Cell_MiddleClick" Tag="4combo">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="3,2">
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource RedBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource RedBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource RedBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource RedBall}" Margin="0.2"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,1,0,0">
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource WhiteBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource WhiteBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource WhiteBall}" Margin="0.2"/>
                                                    <Ellipse Width="5" Height="5" Fill="{StaticResource WhiteBall}" Margin="0.2"/>
                                                </StackPanel>
                                                <TextBlock Text="1:6.8" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,2,0">
                                                <Border CornerRadius="3" Background="#0078D4" Padding="2,1" VerticalAlignment="Center" Margin="0,0,2,0">
                                                    <TextBlock x:Name="BetLbl_4combo" Text="" FontSize="10" FontWeight="Bold" Foreground="White" Visibility="Collapsed"/>
                                                </Border>
                                                <StackPanel Orientation="Vertical">
                                                    <ToggleButton x:Name="Btn_4combo_W" Content="W" Style="{StaticResource MiniWinToggleStyle}" Click="MiniOutcome_Click" Tag="4combo|win"/>
                                                    <ToggleButton x:Name="Btn_4combo_D" Content="D" Style="{StaticResource MiniDrawToggleStyle}" Click="MiniOutcome_Click" Tag="4combo|draw"/>
                                                    <ToggleButton x:Name="Btn_4combo_L" Content="L" Style="{StaticResource MiniLoseToggleStyle}" Click="MiniOutcome_Click" Tag="4combo|lose"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </Grid>

                            <!-- Chip selector row -->
                            <DockPanel Grid.Row="2" Margin="0,4,0,4">
                                <WrapPanel VerticalAlignment="Center" DockPanel.Dock="Left">
                                    <RadioButton Style="{StaticResource ChipButtonStyle}" Content="10" Tag="10" IsChecked="True" Checked="Chip_Checked"/>
                                    <RadioButton Style="{StaticResource ChipButtonStyle}" Content="20" Tag="20" Checked="Chip_Checked"/>
                                    <RadioButton Style="{StaticResource ChipButtonStyle}" Content="50" Tag="50" Checked="Chip_Checked"/>
                                    <RadioButton Style="{StaticResource ChipButtonStyle}" Content="100" Tag="100" Checked="Chip_Checked"/>
                                    <RadioButton Style="{StaticResource ChipButtonStyle}" Content="300" Tag="300" Checked="Chip_Checked"/>
                                </WrapPanel>
                                <TextBox x:Name="InputCustomBet" Width="55" VerticalAlignment="Center" HorizontalAlignment="Right"
                                         Background="#202020" Foreground="White" BorderBrush="{StaticResource BorderColor}"
                                         Padding="4" FontSize="11"
                                         TextChanged="InputCustomBet_TextChanged" GotFocus="InputCustomBet_GotFocus"/>
                            </DockPanel>

                            <!-- Apply + Win / Draw / Lose global buttons -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🏆 Win All" Style="{StaticResource GlobalWinButtonStyle}"
                                        Height="34" FontSize="10" FontWeight="SemiBold" Margin="0,0,2,0"
                                        Click="GlobalResolve_Click" Tag="win"/>
                                <Button Grid.Column="1" Content="🤝 Draw All" Style="{StaticResource GlobalDrawButtonStyle}"
                                        Height="34" FontSize="10" FontWeight="SemiBold" Margin="2,0,2,0"
                                        Click="GlobalResolve_Click" Tag="draw"/>
                                <Button Grid.Column="2" Content="💀 Lose All" Style="{StaticResource GlobalLoseButtonStyle}"
                                        Height="34" FontSize="10" FontWeight="SemiBold" Margin="2,0,2,0"
                                        Click="GlobalResolve_Click" Tag="lose"/>
                                <Button Grid.Column="3" Content="⚡ APPLY" Style="{StaticResource W11PrimaryButtonStyle}"
                                        Height="34" FontSize="11" FontWeight="Bold" Margin="2,0,0,0"
                                        Click="ApplyOutcomes_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Panel 3: History/Log (390 x 580) - placed on the right side of the StackPanel -->
                <Border Style="{StaticResource PanelBorderStyle}" Width="390" Height="580">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="📜 Panel 3: Kết quả toàn bộ ván" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Reset Log" HorizontalAlignment="Right" Style="{StaticResource W11ButtonStyle}" Padding="6,3" Click="ResetLog_Click"/>
                        </DockPanel>

                        <ListBox Grid.Row="1" x:Name="HistoryList" Background="#252525" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Padding="8,5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding RoundTitle}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                <TextBlock Text="{Binding BetDetails}" FontSize="10" Foreground="{StaticResource MutedText}" Margin="0,1,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding ProfitDeltaString}" FontSize="13" FontWeight="Bold"
                                                           Foreground="{Binding ProfitBrush}" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                                <TextBlock Text="{Binding BalanceString}" FontSize="10"
                                                           Foreground="{StaticResource MutedText}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Streak Panel (Roadmap) -->
                        <Border Grid.Row="2" Background="#202020" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,6,0,0">
                            <DockPanel>
                                <TextBlock Text="Roadmap:" FontSize="10" Foreground="{StaticResource MutedText}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ItemsControl x:Name="StreakList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="10" Height="10" Fill="{Binding}" Margin="2"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Alert Banner (shown inline below, full width) -->
                <Border x:Name="BorderAlert" CornerRadius="6" Padding="10,6" BorderThickness="1"
                        Visibility="Collapsed" Margin="6" Width="796">
                    <TextBlock x:Name="TxtAlert" Text="Alert" HorizontalAlignment="Center" FontWeight="Medium" FontSize="12"/>
                </Border>

            </WrapPanel>
        </ScrollViewer>
    </Grid>
</Window>
